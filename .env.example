# ========================================
# CLOUDDIAGNOZE - CONFIGURATION ENVIRONNEMENT
# ========================================
#
# 📋 INSTRUCTIONS :
# 1. Copier ce fichier vers .env : cp .env.example .env
# 2. Remplacer les valeurs "CHANGEZ_MOI_..." par vos propres valeurs
# 3. Lancer avec : docker-compose up -d --build
#
# ⚠️  SÉCURITÉ : Ne jamais commiter le fichier .env dans Git !
# ========================================

# ========================================
# 🗄️  BASE DE DONNÉES MARIADB
# ========================================
# Mot de passe root MariaDB (pour l'administration)
DB_ROOT_PASSWORD=CHANGEZ_MOI_root_password_securise

# Nom de la base de données
DB_NAME=clouddiagnoze

# Utilisateur de l'application
DB_USER=clouddiagnoze_user

# Mot de passe de l'utilisateur (différent du root !)
DB_PASSWORD=CHANGEZ_MOI_user_password_securise

# ========================================
# 🔐 SÉCURITÉ JWT (Authentification)
# ========================================
# Clé secrète pour signer les tokens JWT
# ⚠️ IMPORTANT : Générer une clé forte et unique !
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGEZ_MOI_generer_cle_secrete_avec_python

# Algorithme de signature JWT (ne pas modifier)
JWT_ALGORITHM=HS256

# Durée de validité des tokens (en minutes)
# 10080 = 7 jours
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Cookie httpOnly contenant le JWT
# COOKIE_SECURE=true impose HTTPS (production / nginx)
# Mettre à false uniquement en dev local HTTP
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# ========================================
# ☁️  AWS CREDENTIALS (OBLIGATOIRE pour les scans)
# ========================================
# ⚠️ IMPORTANT : Ces credentials sont nécessaires pour scanner votre infrastructure AWS
#
# 📖 Comment obtenir ces credentials :
# 1. Connectez-vous à AWS Console : https://console.aws.amazon.com
# 2. Allez dans IAM > Users > Votre utilisateur
# 3. Onglet "Security credentials" > "Create access key"
# 4. Copiez l'Access Key ID et le Secret Access Key
#
# 🔒 Permissions IAM requises :
# - ec2:DescribeInstances, ec2:DescribeVolumes, ec2:DescribeVpcs...
# - s3:ListAllMyBuckets, s3:GetBucketLocation, s3:GetBucketEncryption...
# - rds:DescribeDBInstances...
# - sts:AssumeRole (pour scanner les comptes clients)
# - cloudwatch:GetMetricStatistics (pour les métriques de performance)

AWS_ACCESS_KEY_ID=CHANGEZ_MOI_votre_access_key_id
AWS_SECRET_ACCESS_KEY=CHANGEZ_MOI_votre_secret_access_key
AWS_DEFAULT_REGION=eu-west-1

# ========================================
# ⚙️  APPLICATION
# ========================================
# Environnement (development ou production)
ENVIRONMENT=production
