# ========================================
# CLOUDDIAGNOZE - CONFIGURATION BACKEND
# ========================================
#
# 📋 Ce fichier est pour le DÉVELOPPEMENT LOCAL (sans Docker)
# Pour Docker, utilisez le .env.example à la racine du projet
#
# Instructions :
# 1. Copier ce fichier vers .env : cp .env.example .env
# 2. Modifier les valeurs selon votre environnement
# 3. Lancer : uvicorn main:app --reload
# ========================================

# ========================================
# 🔐 SÉCURITÉ JWT
# ========================================
# Clé secrète pour signer les tokens JWT
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGEZ_MOI_dev_secret_key

# Algorithme de signature JWT
JWT_ALGORITHM=HS256

# Durée de validité des tokens (en minutes) - 7 jours
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ========================================
# 🌐 CORS (Cross-Origin Resource Sharing)
# ========================================
# Domaines autorisés (séparés par des virgules)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500

# ========================================
# 🗄️  BASE DE DONNÉES
# ========================================
# En dev local : localhost (Docker expose le port 3306)
# Avec Docker Compose : mariadb (nom du service)
DB_HOST=localhost
DB_PORT=3306
DB_USER=clouddiagnoze_user
DB_PASSWORD=CHANGEZ_MOI_user_password
DB_NAME=clouddiagnoze

# ========================================
# ☁️  AWS CREDENTIALS
# ========================================
# Nécessaires pour scanner l'infrastructure AWS
# Si AWS CLI est configuré (~/.aws/credentials), ces variables sont optionnelles
AWS_ACCESS_KEY_ID=votre_access_key_id
AWS_SECRET_ACCESS_KEY=votre_secret_access_key
AWS_DEFAULT_REGION=eu-west-1

# ========================================
# ⚙️  APPLICATION
# ========================================
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
